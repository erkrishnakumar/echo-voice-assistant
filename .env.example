# Copy this file to .env and adjust values.
#   cp .env.example .env
# .env is gitignored and holds your real config. This template is committed
# so anyone cloning the repo knows which keys exist.

USER_NAME=Krishna
USER_TITLE=Sir

# --- LLM Provider (ollama | groq) ---
LLM_PROVIDER=groq
# If using groq, set your API key:
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional: when Groq is rate-limited (429), Echo automatically falls back to
# Gemini for that turn, then back to Groq once Gemini is also rate-limited.
# Get a free key at https://aistudio.google.com/apikey — leave unset to skip
# this fallback entirely.
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (the local LLM brain, runs in Docker) ---
OLLAMA_URL=http://localhost:11434/api/chat
ECHO_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m

# --- agent behaviour ---
ECHO_MAX_TOOL_ROUNDS=4
ECHO_TIMEOUT=120

# --- PostgreSQL (runs in Docker) ---
# These are read by BOTH docker-compose (to create the DB) and the app
# (to connect to it). Keep them in sync.
POSTGRES_USER=echo
POSTGRES_PASSWORD=
POSTGRES_DB=echo
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Optionally set a full URL to override the parts above:
DATABASE_URL=postgresql+psycopg2://echo:echo_pass@127.0.0.1:5433/echo_db
# --- API ---
ECHO_API_HOST=0.0.0.0
ECHO_API_PORT=8000

# --- Voice (whisper.cpp STT + Piper TTS + openWakeWord) ---
# These point at binaries/models you download during voice setup.
# See docs/voice-setup.md. Defaults match the layout the setup creates.
WHISPER_BIN=bin/whisper/Release/whisper-cli.exe
WHISPER_MODEL=bin/models/ggml-base.en.bin
PIPER_BIN=bin/piper/piper/piper.exe
PIPER_MODEL=bin/models/en_US-amy-medium.onnx
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5
# tune these if it cuts you off too early or waits too long:
VOICE_SILENCE_THRESHOLD=400
VOICE_SILENCE_SECONDS=2.2
VOICE_MAX_UTTERANCE_SECONDS=15
VOICE_CONVERSATION_TIMEOUT=12
ECHO_LLM_RETRIES=2
